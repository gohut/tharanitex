{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tharanitextiles",
	"main": ".open-next/worker.js",
	"assets": {
		"directory": ".open-next/assets"
	},
	"compatibility_date": "2026-07-31",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tharani-db",
			"database_id": "dff51ca2-b626-4cb4-85d5-87ca19e71c6a"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "fb0749b3812945bf9254861f77cbaf23"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "tharani-product-images",
			"binding": "tharani_product_images"
		}
	],
	"observability": {
		"enabled": true,
			"logs": {
				"invocation_logs": true
			}
		}
}