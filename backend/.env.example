# SMS Gateway Configuration (.env.local)

# Options: 'mock' (default for local dev), 'twilio', 'msg91', 'textlocal'
SMS_PROVIDER=mock

# Twilio Credentials (If using Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+1234567890

# MSG91 Credentials (If using MSG91 in India)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id

# Textlocal Credentials
TEXTLOCAL_API_KEY=your_textlocal_api_key
TEXTLOCAL_SENDER=TXTLCL
