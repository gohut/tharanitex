{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tharanitex-backend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "8b5dc392d21c4d7b88546d434e6cc9bb"
    }
  ]
}
