{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tharanitex-backend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "8b5dc392d21c4d7b88546d434e6cc9bb"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tharanitex-d1",
      "database_id": "5902446c-900d-4967-a371-f0be1e911bdc"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "tharanitex-images"
    }
  ]
}
